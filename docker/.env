# Arguments passés aux conteneurs par docker-compose.yml.
# Pour les modifier : changer une valeur ici, puis `docker compose up -d`
# (compose ne recrée que les conteneurs dont la configuration a changé).

# Version d'Alpine de l'image de base (l'archive doit être dans base/rootfs/).
ALPINE_VERSION=3.24.2

# --- db : PostgreSQL ---
DB_NAME=luniqo
DB_USER=luniqo
# Fichier du mot de passe, monté en secret Docker dans /run/secrets. Par
# défaut : secrets/db_password.dev, valeur de développement versionnée (la
# base n'est joignable que depuis le réseau interne). Hors TP, pointer vers
# un fichier non versionné.
# DB_PASSWORD_FILE=/chemin/hors/depot/db_password
DB_CPUS=1.0
DB_MEMORY=256M
DB_PIDS=48
DB_MAX_CONNECTIONS=20
DB_SHARED_BUFFERS=64MB

# --- api : FastAPI ---
API_CPUS=0.5
API_MEMORY=128M
API_PIDS=32
API_WORKERS=1
API_DB_POOL_SIZE=8
API_SEED_DEMO=true

# --- front : Next.js ---
FRONT_CPUS=1.0
FRONT_MEMORY=384M
FRONT_PIDS=48
FRONT_NODE_HEAP_MB=192
# Projet Supabase de la v1 : NEXT_PUBLIC_SUPABASE_URL et
# NEXT_PUBLIC_SUPABASE_ANON_KEY sont lus dans le .env de l'application (racine
# du dépôt, non versionné). Ne pas les écrire ici. Lancement :
#   docker compose --env-file .env --env-file ../.env up -d --build
# Sans eux, le front démarre mais la connexion échoue.

# --- web : passerelle nginx ---
WEB_CPUS=0.25
WEB_MEMORY=32M
WEB_PIDS=16
WEB_WORKER_PROCESSES=1
WEB_WORKER_CONNECTIONS=512
WEB_PUBLISHED_PORT=8080
