# Arguments passés aux conteneurs par docker-compose.yml.
# Pour les modifier : changer une valeur ici, puis `docker compose up -d`
# (compose ne recrée que les conteneurs dont la configuration a changé).

# Version d'Alpine de l'image de base (l'archive doit être dans base/rootfs/).
ALPINE_VERSION=3.24.2

# --- db : PostgreSQL ---
DB_NAME=luniqo
DB_USER=luniqo
# Fichier du mot de passe, monté en secret Docker dans /run/secrets. Par
# défaut : secrets/db_password.dev, valeur de développement versionnée (la
# base n'est joignable que depuis le réseau interne). Hors TP, pointer vers
# un fichier non versionné.
# DB_PASSWORD_FILE=/chemin/hors/depot/db_password
DB_CPUS=1.0
DB_MEMORY=256M
DB_PIDS=48
DB_MAX_CONNECTIONS=20
DB_SHARED_BUFFERS=64MB

# --- api : FastAPI ---
API_CPUS=0.5
API_MEMORY=128M
API_PIDS=32
API_WORKERS=1
API_DB_POOL_SIZE=8
API_SEED_DEMO=true

# --- web : passerelle nginx ---
WEB_CPUS=0.25
WEB_MEMORY=32M
WEB_PIDS=16
WEB_WORKER_PROCESSES=1
WEB_WORKER_CONNECTIONS=512
WEB_PUBLISHED_PORT=8080

# === Chaîne de CI (docker-compose.ci.yml, lancée par ./pipeline.sh) ===
# Conteneurs éphémères : ils font leur travail une fois et s'arrêtent.

# --- lint : ruff, ShellCheck, FROM autorisés ---
LINT_CPUS=1.0
LINT_MEMORY=128M
LINT_PIDS=16
# concise, full, github (annotations dans les PR), grouped ou pylint
LINT_RUFF_FORMAT=concise

# --- test : pytest, unitaires et intégration ---
TEST_CPUS=1.0
TEST_MEMORY=512M
TEST_PIDS=32
# Secondes laissées à pytest pour s'arrêter après le signal d'arrêt.
TEST_STOP_TIMEOUT=5

# --- test-db : PostgreSQL jetable, données en mémoire ---
TEST_DB_CPUS=1.0
# Le tmpfs des données est compté dans cette limite.
TEST_DB_MEMORY=256M
TEST_DB_PIDS=48
TEST_DB_TMPFS=128m
TEST_DB_MAX_CONNECTIONS=30
TEST_DB_SHARED_BUFFERS=32MB

# === Banc de mesure (docker-compose.bench.yml, lancé par bench/bench.sh) ===

# --- charge : générateur de charge wrk ---
BENCH_CPUS=1.0
BENCH_MEMORY=32M
BENCH_PIDS=8
# La charge elle-même (BENCH_DURATION, BENCH_CONNECTIONS, BENCH_THREADS,
# BENCH_PAGE_PATH) se règle au lancement du banc, qui la transmet au
# conteneur : BENCH_DURATION=60 bench/bench.sh
