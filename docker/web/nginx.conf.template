# Modèle de configuration nginx. entrypoint.sh remplace les marqueurs __XXX__
# par les arguments reçus au run, puis écrit le résultat dans /tmp/nginx.

# Nombre de processus workers. Fixé explicitement : "auto" compterait les
# cœurs de la machine hôte, sans tenir compte de la limite CPU du conteneur.
worker_processes __WORKER_PROCESSES__;

# Le système de fichiers de l'image peut être en lecture seule : le PID va
# dans /tmp (tmpfs), les logs sur la sortie standard récupérée par Docker.
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    # Connexions simultanées maximum par worker.
    worker_connections __WORKER_CONNECTIONS__;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /dev/stdout;
    sendfile on;
    server_tokens off;
    client_max_body_size 10m;

    # Fichiers temporaires dans /tmp, accessible en écriture à l'utilisateur app.
    client_body_temp_path /tmp/nginx/client_body;
    proxy_temp_path /tmp/nginx/proxy;
    fastcgi_temp_path /tmp/nginx/fastcgi;
    uwsgi_temp_path /tmp/nginx/uwsgi;
    scgi_temp_path /tmp/nginx/scgi;

    # DNS interne de Docker. Les adresses des services sont mises dans des
    # variables : nginx les résout à chaque requête (cache de 10 s) et non une
    # seule fois au démarrage. Conséquences :
    # - la passerelle démarre même si un service est absent (réponse 502) ;
    # - un service recréé avec une nouvelle IP est retrouvé sans redémarrer nginx.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 2s;

    # En-têtes de sécurité des réponses de l'API. Les fichiers du front ont les
    # leurs, CSP comprise (security-headers.conf) : la CSP stricte du front
    # bloquerait Swagger UI (/api/docs), qui charge ses scripts depuis un CDN.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # En-têtes transmis aux services : hôte d'origine et adresse du client.
    # X-Forwarded-For est remplacé, pas complété : la passerelle est le seul
    # point d'entrée, et une valeur envoyée par le client lui permettrait de
    # choisir l'adresse vue par l'API (contournement de la limitation des
    # tentatives de connexion par IP, LUN-003).
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;

    server {
        listen 8080;

        set $api_upstream http://__API_ADDR__;

        # Front v2 : application monopage construite par Vite (ADR-002).
        # Une adresse sans fichier correspondant (/accueil, /connexion…) reçoit
        # index.html : c'est le routeur du navigateur qui affiche la page.
        root /srv/front;
        location / {
            try_files $uri /index.html;
            include /etc/nginx/security-headers.conf;
            # Jamais gardé en cache sans revalidation : une nouvelle version
            # est prise au chargement suivant.
            add_header Cache-Control "no-cache" always;
        }

        # Fichiers produits par Vite : leur nom contient l'empreinte de leur
        # contenu, ils ne changent jamais. Fichier absent : 404, pas index.html.
        location /assets/ {
            try_files $uri =404;
            include /etc/nginx/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        # API FastAPI. L'URI est transmise telle quelle : les routes de l'API
        # commencent elles-mêmes par /api.
        location /api/ {
            proxy_pass $api_upstream;
            proxy_read_timeout 30s;
        }

        # Service absent ou en erreur : page d'attente plutôt qu'une erreur brute.
        error_page 502 503 504 /indisponible.html;
        location = /indisponible.html {
            root /srv/www;
            internal;
        }

        # Utilisé par le healthcheck : ne dépend que de nginx.
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }
    }
}
